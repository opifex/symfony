includes:
  - ../../vendor/phpat/phpat/extension.neon
  - ../../vendor/phpstan/phpstan-deprecation-rules/rules.neon
  - ../../vendor/phpstan/phpstan-doctrine/extension.neon
  - ../../vendor/phpstan/phpstan-strict-rules/rules.neon
  - ../../vendor/phpstan/phpstan-symfony/extension.neon
parameters:
  level: max
  tmpDir: ../../var/phpstan
  checkBenevolentUnionTypes: true
  checkUninitializedProperties: true
  paths:
    - ../../src
  ignoreErrors:
    - { identifier: attribute.deprecated, message: '#OpenApi\\Attributes#', path: ../../src/Presentation/Controller }
    - { identifier: method.deprecatedClass, message: '#OpenApi\\Attributes#', path: ../../src/Presentation/Controller }
    - { identifier: new.deprecatedClass, message: '#OpenApi\\Attributes#', path: ../../src/Presentation/Controller }
services:
  - { class: Tests\Architecture\LayerDependenciesTest, tags: [ phpat.test ] }
